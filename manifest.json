{
  "manifest_version": 3,
  "name": "GitHub Git Notes Viewer",
  "version": "1.1.0",
  "description": "Display git notes inline on GitHub commit pages.",
  "browser_specific_settings": {
    "gecko": {
      "id": "git-notes-viewer@trailblaze.work",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "optional_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/host.js", "lib/storage.js", "lib/notes.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/commit/*"],
      "js": [
        "lib/purify.min.js",
        "lib/marked.min.js",
        "lib/host.js",
        "lib/storage.js",
        "lib/notes.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
